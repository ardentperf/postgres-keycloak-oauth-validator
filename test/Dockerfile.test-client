FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    openssl \
    ca-certificates \
    postgresql-client \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install libpq-oauth if available (PG 18 OAuth SASL support)
# It may be packaged as part of postgresql-client on trixie
RUN apt-cache show libpq-oauth 2>/dev/null && \
    apt-get install -y --no-install-recommends libpq-oauth || true

COPY run_tests.sh /app/run_tests.sh
RUN chmod +x /app/run_tests.sh

ENTRYPOINT ["/app/run_tests.sh"]
